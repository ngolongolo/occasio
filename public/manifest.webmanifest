{
  "name": "Okesheni",
  "short_name": "Okesheni",
  "description": "Create invitations, manage guests, collect RSVPs and coordinate every occasion.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#fcf9f4",
  "theme_color": "#56283f",
  "lang": "en",
  "categories": ["business", "productivity", "lifestyle"],
  "icons": [
    { "src": "/assets/logo/favicon.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/logo/favicon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/logo/favicon.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Find an occasion", "short_name": "Find", "url": "/#public-event-code", "icons": [{ "src": "/assets/logo/favicon.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "My events", "short_name": "Events", "url": "/dashboard", "icons": [{ "src": "/assets/logo/favicon.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
